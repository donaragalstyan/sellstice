DATABASE_URL="postgresql://sellstice:sellstice@localhost:5432/sellstice?schema=public"
AUTH_SECRET="generate-with-npx-auth-secret"

# Required for AI item-photo analysis (Phase 3+). Without it, analysis
# requests fail gracefully — items remain fully usable without AI.
ANTHROPIC_API_KEY=""

# Optional. Model used for routine item-photo analysis — defaults to
# claude-haiku-4-5 (cheap, vision-capable, supports structured outputs; this
# is a bounded extraction task, not open-ended reasoning). Override to
# benchmark a stronger model, e.g. claude-sonnet-5 or claude-opus-5.
ITEM_ANALYSIS_AI_MODEL=""
