DATABASE_URL="postgresql://sellstice:sellstice@localhost:5432/sellstice?schema=public"
AUTH_SECRET="generate-with-npx-auth-secret"

# Required for AI item-photo analysis (Phase 3+). Without it, analysis
# requests fail gracefully — items remain fully usable without AI.
ANTHROPIC_API_KEY=""

# Optional. Model used for routine item-photo analysis — defaults to
# claude-haiku-4-5 (cheap, vision-capable, supports structured outputs; this
# is a bounded extraction task, not open-ended reasoning). Override to
# benchmark a stronger model, e.g. claude-sonnet-5 or claude-opus-5.
ITEM_ANALYSIS_AI_MODEL=""

# Optional. Model used for Photo Coach (per-photo scoring/critique) —
# configured independently from item analysis. Also defaults to
# claude-haiku-4-5; override if qualitative feedback quality is too weak.
PHOTO_COACH_AI_MODEL=""

# Optional, and no longer used by the active provider (comparables.ts now
# instantiates BraveDiscoveryComparableProvider — see the Phase 5.6 block
# below). Only read by the retired WebSearchComparableProvider
# (src/server/research/providers/web-search.ts), which is unreferenced in
# production and staged for deletion once the new provider is verified live.
MARKET_RESEARCH_AI_MODEL=""

# Optional, same retired-provider caveat as MARKET_RESEARCH_AI_MODEL above.
MARKET_RESEARCH_MAX_SEARCH_USES=""

# Optional. Per-request timeout (ms) when fetching a discovered listing's
# page server-side for price verification. Defaults to 8000. A single
# attempt, no retries — a slow/hanging marketplace just leaves that one
# comp's price unverified rather than blocking the whole research run.
MARKET_RESEARCH_FETCH_TIMEOUT_MS=""

# Optional. How many listing pages to fetch concurrently during price
# verification. Defaults to 4. Higher values finish enrichment faster at the
# cost of more simultaneous outbound requests to marketplace sites.
MARKET_RESEARCH_FETCH_CONCURRENCY=""

# --- Phase 5.6: Sellstice-controlled discovery ------------------------------
# Live: comparables.ts now instantiates BraveDiscoveryComparableProvider,
# which discovers via Brave (Vinted/Depop/Poshmark/Mercari) then runs the
# bounded, tool-free match step below — see src/server/research/discovery/.
# eBay's adapter is still an interface-only stub (blocked on credentials).
# Never commit real values here — this file only documents which variables
# exist.

# Optional. Model used for the bounded, tool-free comparable-matching step
# (src/server/research/discovery/match-candidates.ts) — judges candidates
# Sellstice's own discovery already retrieved, no search tool involved.
# Independent of MARKET_RESEARCH_AI_MODEL above (different task, own
# default). Defaults to claude-sonnet-5 for the same real-reasoning
# rationale as the retired web_search provider.
MARKET_RESEARCH_MATCH_AI_MODEL=""

# eBay Browse API (Production keyset). Used for OAuth2 client-credentials
# token requests (POST https://api.ebay.com/identity/v1/oauth2/token,
# scope=https://api.ebay.com/oauth/api_scope) — no separate approval needed
# for public item search. See developer.ebay.com. Not yet used —
# EbayMarketplaceDiscoveryProvider is a stub until credentials arrive.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""

# Brave Search API subscription token (X-Subscription-Token header), used
# for domain-restricted discovery on marketplaces without an official API
# (Poshmark, Depop, Vinted, Mercari). See api-dashboard.search.brave.com.
BRAVE_SEARCH_API_KEY=""
