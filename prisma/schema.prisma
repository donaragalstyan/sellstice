// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  goals        Goal[]
  items        Item[]
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model Goal {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetAmountCents Int
  startDate         DateTime   @default(now())
  deadline          DateTime
  status            GoalStatus @default(ACTIVE)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([userId])
}

enum ItemStatus {
  INVENTORY
  READY_TO_LIST
  LISTED
  SOLD
  ARCHIVED
}

enum ItemCondition {
  NEW_WITH_TAGS
  NEW_WITHOUT_TAGS
  LIKE_NEW
  GOOD
  FAIR
}

// Deliberately separate from Listing (introduced in a later phase): a user
// can own an item long before deciding whether/when to list it for sale.
model Item {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand                String?
  color                String?
  category             String?
  size                 String?
  condition            ItemCondition?
  notableDetails       String?
  acquisitionCostCents Int?
  status               ItemStatus     @default(INVENTORY)
  photos               ItemPhoto[]
  aiAnalyses           ItemAIAnalysis[]
  photoCoachAnalyses   PhotoCoachAnalysis[]
  comparableListings   ComparableListing[]
  researchRuns         ComparableResearchRun[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId])
}

// No `url` column: photos are served only through the authenticated
// /api/photos/[id] route, which derives the URL from this row's id and
// looks up storageKey itself — storing a public URL here would either go
// stale or (if kept in sync) be pure redundancy with `id`.
model ItemPhoto {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storageKey String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  photoCoachScores PhotoCoachPhotoScore[]

  @@index([itemId])
}

// Raw AI vision output, kept separate from Item's canonical fields so we
// always know whether a value came from the model or from user confirmation.
// Applying a suggestion copies it into Item explicitly (see appliedFields) —
// nothing here is ever treated as ground truth on its own.
model ItemAIAnalysis {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  brandValue          String?
  brandConfidence      Float?
  colorValue           String?
  colorConfidence      Float?
  itemTypeValue        String?
  itemTypeConfidence   Float?
  categoryValue        String?
  categoryConfidence   Float?
  conditionValue       ItemCondition?
  conditionConfidence  Float?

  styleKeywords           String[]
  visibleDetails          String[]
  missingPhotoSuggestions String[]

  // Which suggested fields the user has explicitly applied to the Item
  // (e.g. "brand", "condition") — provenance for what's user-confirmed.
  appliedFields String[]

  modelId   String
  createdAt DateTime @default(now())

  @@index([itemId])
}

enum MissingShotType {
  BRAND_TAG
  SIZE_TAG
  MATERIAL_TAG
  BACK_VIEW
  FLAW_CLOSEUP
  MODELED_PHOTO
  FLAT_LAY
}

// Advice only — Photo Coach never touches the underlying photo files, and
// this table never feeds back into Item or ItemPhoto. It's a separate,
// disposable opinion about an existing photo set, not canonical data.
model PhotoCoachAnalysis {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  missingShots MissingShotType[]

  modelId   String
  createdAt DateTime @default(now())

  scores PhotoCoachPhotoScore[]

  @@index([itemId])
}

// One row per photo covered by a given analysis. Cascades away with either
// its parent analysis or the underlying photo — a deleted photo just drops
// its score row rather than leaving a dangling reference.
model PhotoCoachPhotoScore {
  id         String             @id @default(cuid())
  analysisId String
  analysis   PhotoCoachAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  photoId    String
  photo      ItemPhoto          @relation(fields: [photoId], references: [id], onDelete: Cascade)

  // Snapshot of the photo's gallery position at analysis time, so "Photo 3"
  // in a past analysis still means something after photos are added/removed.
  photoOrder Int

  score       Float
  isBestCover Boolean @default(false)

  lightingOk       Boolean
  lightingFeedback String?
  framingOk        Boolean
  framingFeedback  String?
  backgroundOk       Boolean
  backgroundFeedback String?
  shapeVisibleOk       Boolean
  shapeVisibleFeedback String?

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([photoId])
}

enum ComparableSource {
  WEB_SEARCH
  MANUAL
}

// Never SOLD unless the source explicitly said so — see the WebSearchComparableProvider
// prompt. UNKNOWN is a valid, expected outcome, not a fallback to avoid.
enum ComparablePriceType {
  ASKING
  SOLD
  UNKNOWN
}

// Provenance of a comparable's priceCents, not a probability score — a price
// is either backed by something deterministic we parsed, or it isn't. Kept
// separate from matchConfidence (an AI judgment call) deliberately: a
// well-matched listing can still have an unverifiable price, and a
// perfectly-verified price is worthless if the listing itself is a bad
// match. STRUCTURED_DATA/META_TAG/MICRODATA are the only values that should
// ever accompany a non-null priceCents on a WEB_SEARCH comp (see
// isUsableComparable in comparables.ts). Null for manual entries — same
// rationale as matchConfidence being null there.
enum ComparablePriceEvidence {
  STRUCTURED_DATA
  META_TAG
  MICRODATA
  UNVERIFIED
  BLOCKED
}

// One research invocation (a single web-search call). Comparables accumulate
// across runs (re-running adds to the set rather than replacing it), so this
// is what "reopening an item does not trigger another paid call" actually
// caches against — the run's createdAt drives the cooldown, and its
// querySnapshot records exactly what attributes were searched at the time.
model ComparableResearchRun {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  querySnapshot Json
  resultCount   Int

  createdAt DateTime @default(now())
  listings  ComparableListing[]

  @@index([itemId])
}

// A single comparable listing, normalized regardless of whether it came from
// automated search or manual entry. Every field except title is nullable —
// a comp with partial/unknown data is still valid and gets stored; it's the
// deterministic quality assessment (see comparables.ts) that decides whether
// the overall set is trustworthy enough to lean on, not this table.
model ComparableListing {
  id            String                 @id @default(cuid())
  itemId        String
  item          Item                   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  researchRunId String?
  researchRun   ComparableResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: Cascade)

  source      ComparableSource
  title       String
  marketplace String?
  priceCents  Int?
  priceType   ComparablePriceType @default(UNKNOWN)
  url         String?
  condition   String?
  // Free text, deliberately not a Date — search snippets rarely give a real
  // date, and forcing one into a DateTime would fabricate false precision.
  recency     String?
  // How well this listing matches the item's attributes (brand/category/
  // condition/etc.) — an AI judgment call. Null for manual entries (the user
  // is the source, not a model estimate). Deliberately separate from
  // priceEvidence — see that enum's doc comment.
  matchConfidence Float?
  // Deliberately separate from matchConfidence — see ComparablePriceEvidence.
  // Null for manual entries (nothing to attribute automated evidence to).
  priceEvidence   ComparablePriceEvidence?
  rawMetadata Json?

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([researchRunId])
}
